# Use ONE of these. Groq is much faster (free key: https://console.groq.com/keys).
# If both are set, Groq is used.
GROQ_API_KEY=paste_your_key_here
GEMINI_API_KEY=paste_your_key_here
# Optional:
# WISP_LANGUAGE=en           (en or tr = only that language; auto = English/Turkish/Azerbaijani)
# WISP_AVATAR=cartoon        (cartoon, orb, island or off)
# Natural AI voice: install Voicebox (github.com/jamiepine/voicebox) and create a voice profile with this
# name (e.g. a Kokoro preset voice). Wisp starts Voicebox's server itself; the window needn't be open.
# A Turkish profile must use the Chatterbox Multilingual engine (only needed with WISP_LANGUAGE=tr/auto).
# WISP_VOICEBOX_EN=Wisp EN
# WISP_VOICEBOX_TR=Wisp TR
# WISP_GROQ_STT=whisper-large-v3
# WISP_GROQ_MODEL=openai/gpt-oss-120b
# WISP_GROQ_VISION=qwen/qwen3.8-27b
# WISP_HOTKEY=right ctrl     (set any hotkey to "off" to disable that mode, e.g. WISP_HOTKEY=off)
# WISP_CMD_HOTKEY=right shift
# WISP_SCREEN_HOTKEY=f9
# WISP_VOICE_REPLIES=1
# WISP_MODEL=gemini-flash-latest
